# Root .gitignore for SkeuoLab Full-Stack Repository

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Environment Variables & Secrets
**/.env
**/.env.*
!**/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node.js & Backend
**/node_modules/
**/dist/
**/coverage/
.npm/
.eslintcache

# Flutter & Dart
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/build/
**/doc/api/
**/ios/Flutter/.last_build_id
app.*.symbols
app.*.map.json

# IDE & Editor Configurations
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# Build artifacts
frontend/android/app/debug/
frontend/android/app/profile/
frontend/android/app/release/
